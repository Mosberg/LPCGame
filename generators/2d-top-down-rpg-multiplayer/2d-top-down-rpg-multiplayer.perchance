// ---------------------------------------------------------------------------
// Skills: gatherable nodes and what the player must have to work them.
// Read by src/resources.js. `tool`: required tool type; `tier`: minimum tool
// tier; `level`: minimum skill. `gathers`: successful rolls before depletion.
// ---------------------------------------------------------------------------
getResourceDefs() =>
  const node = (id, kind, skill, level, xp, tool, tier, product, gathers, respawn, name, extra) => Object.assign({ id, kind, skill, level, xp, tool, tier, product, gathers, respawn, name }, extra || {});
  return [
    // Woodcutting
    node("treeBasic", "tree", "woodcutting", 1, 25, "axe", 1, "logs", 5, 16, "Tree"),
    node("treeOak", "tree", "woodcutting", 15, 38, "axe", 1, "oakLogs", 5, 22, "Oak Tree"),
    node("treeWillow", "tree", "woodcutting", 30, 68, "axe", 2, "willowLogs", 4, 28, "Willow Tree"),
    node("treeYew", "tree", "woodcutting", 45, 120, "axe", 3, "yewLogs", 4, 36, "Yew Tree"),
    node("treeMagic", "tree", "woodcutting", 60, 210, "axe", 4, "magicLogs", 3, 48, "Magic Tree"),
    node("treeSpirit", "tree", "woodcutting", 75, 320, "axe", 5, "magicLogs", 3, 60, "Spirit Tree"),

    // Mining
    node("rockCopper", "rock", "mining", 1, 18, "pickaxe", 1, "copperOre", 4, 14, "Copper Rock"),
    node("rockTin", "rock", "mining", 1, 18, "pickaxe", 1, "tinOre", 4, 14, "Tin Rock"),
    node("rockIron", "rock", "mining", 15, 35, "pickaxe", 1, "ironOre", 4, 20, "Iron Rock"),
    node("rockCoal", "rock", "mining", 30, 50, "pickaxe", 2, "coal", 4, 26, "Coal Rock"),
    node("rockGold", "rock", "mining", 25, 65, "pickaxe", 2, "goldOre", 3, 30, "Gold Rock"),
    node("rockMithril", "rock", "mining", 45, 80, "pickaxe", 3, "mithrilOre", 3, 36, "Mithril Rock"),
    node("rockAdamant", "rock", "mining", 60, 120, "pickaxe", 4, "adamantOre", 3, 46, "Adamant Rock"),
    node("rockRune", "rock", "mining", 80, 200, "pickaxe", 5, "runeOre", 2, 60, "Rune Rock"),
    node("rockGem", "rock", "mining", 20, 45, "pickaxe", 2, "sapphire", 1, 50, "Gem Rock", { gems: true }),

    // Fishing
    node("fishShrimp", "fish", "fishing", 1, 20, "net", 1, "rawShrimp", 6, 12, "Shrimp Shoal"),
    node("fishTrout", "fish", "fishing", 15, 45, "rod", 1, "rawTrout", 5, 18, "Trout Run"),
    node("fishSalmon", "fish", "fishing", 30, 75, "rod", 2, "rawSalmon", 4, 24, "Salmon Run"),
    node("fishLobster", "fish", "fishing", 45, 110, "harpoon", 1, "rawLobster", 3, 30, "Lobster Shelf"),
    node("fishShark", "fish", "fishing", 60, 160, "harpoon", 2, "rawShark", 3, 38, "Shark Water"),

    // Hunter
    node("huntRabbit", "hunter", "hunter", 1, 30, "snare", 1, "rawRabbit", 4, 24, "Rabbit Burrow"),
    node("huntBird", "hunter", "hunter", 10, 44, "snare", 1, "rawBird", 4, 24, "Bird Flock"),
    node("huntFur", "hunter", "hunter", 25, 70, "snare", 2, "fur", 3, 32, "Fur Game"),
    node("huntImp", "hunter", "hunter", 50, 150, "snare", 3, "sapphire", 2, 60, "Wild Imp", { rare: true }),

    // Farming patches are planted, not gathered in place.
    node("patch", "patch", "farming", 1, 0, null, 0, null, 0, 0, "Farming Patch"),
  ];

// Slayer master tasks. `enemy` matches an enemy key; need = kills required.
getSlayerTasks() =>
  return [
    { id: "taskWolf",   enemy: "wolf",   need: 8, level: 1,  xp: 60,  gold: 120, name: "Grey Wolves" },
    { id: "taskSlime",  enemy: "slime",  need: 12, level: 1,  xp: 40,  gold: 90,  name: "Verdant Slimes" },
    { id: "taskBandit", enemy: "bandit", need: 6, level: 12, xp: 120, gold: 200, name: "Mosswood Bandits" },
    { id: "taskHusk",   enemy: "husk",   need: 8, level: 20, xp: 150, gold: 240, name: "Bone Husks" },
    { id: "taskWraith", enemy: "wraith", need: 6, level: 35, xp: 280, gold: 380, name: "Ember Wraiths" },
  ];

// Farming crops. `seed` is consumed on planting; maturity ripens after
// `grow` seconds (scaled by config.cropStageSeconds / 40).
getFarmCrops() =>
  return [
    { id: "potato",    name: "Potatoes",    seed: "potatoSeed",    level: 1,  xp: 10, grow: 60,  yield: ["potato", 3] },
    { id: "flower",    name: "Cut Flowers", seed: "flowerSeed",    level: 10, xp: 18, grow: 90,  yield: ["flower", 3] },
    { id: "herb",      name: "Clean Herbs", seed: "herbSeed",      level: 15, xp: 26, grow: 130, yield: ["herbs", 3] },
    { id: "moonpetal", name: "Moonpetals",  seed: "moonpetalSeed", level: 25, xp: 50, grow: 190, yield: ["moonpetal", 2] },
  ];
